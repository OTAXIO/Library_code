{
  "manifest_version": 3,
  "name": "SA 比对半自动助手",
  "version": "0.4.12",
  "description": "自动认领与 WOS 自动导入；通过桌面助手串行执行，核验网页及名单回写，未知情况暂停。",
  "permissions": ["storage", "scripting", "activeTab", "downloads", "alarms"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://admin.ir.lib.sjtu.edu.cn/*",
    "https://admin.ir.lib.sjtu.edu.cn/*",
    "https://www.webofscience.com/*",
    "https://webofscience.clarivate.cn/*"
  ],
  "content_scripts": [{"matches": ["https://www.webofscience.com/wos/*", "https://webofscience.clarivate.cn/wos/*", "http://admin.ir.lib.sjtu.edu.cn/*", "https://admin.ir.lib.sjtu.edu.cn/*"], "js": ["content.js"]}],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "连接 SA 比对助手"}
}
