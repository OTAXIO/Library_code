{
  "manifest_version": 3,
  "name": "SA 比对半自动助手",
  "version": "0.2.0",
  "description": "连接本机弹窗，仅在已登录的机构知识库比对页执行经人工确认的操作。",
  "permissions": ["storage", "scripting", "activeTab"],
  "host_permissions": [
    "http://127.0.0.1:8765/*",
    "http://admin.ir.lib.sjtu.edu.cn/*",
    "https://admin.ir.lib.sjtu.edu.cn/*"
  ],
  "background": {"service_worker": "background.js"},
  "action": {"default_popup": "popup.html", "default_title": "连接 SA 比对助手"}
}
